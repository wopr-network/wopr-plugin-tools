{
  "name": "@wopr-network/wopr-plugin-tools",
  "version": "2.0.0",
  "description": "Meta package providing http and exec capabilities - depends on wopr-plugin-http and wopr-plugin-exec",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "check": "biome check src/ && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "wopr",
    "wopr-plugin",
    "plugin",
    "tools",
    "http",
    "exec",
    "fetch",
    "meta"
  ],
  "author": "WOPR",
  "license": "MIT",
  "dependencies": {
    "@wopr-network/plugin-types": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@wopr-network/wopr-plugin-http": ">=0.1.0",
    "@wopr-network/wopr-plugin-exec": ">=0.1.0"
  }
}
